<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Gordon Athletic Advisory</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Gordon Athletic Advisory</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.gordonathletic.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.gordonathletic.app</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>NSHealthShareUsageDescription</key>
	<string>Gordon Athletic Advisory reads your heart rate, HRV, active calories, sleep architecture, workouts, and dietary nutrition to calculate real-time CNS readiness and calibrate your periodized coaching program.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Gordon Athletic Advisory logs completed workout sessions and cardio telemetry directly into Apple Health.</string>
	<key>NSCameraUsageDescription</key>
	<string>Gordon Athletic Advisory uses your camera for 1:1 live telehealth video consultations, real-time MediaPipe 3D postural distortion mesh scans, and lifting form critique capture.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Gordon Athletic Advisory uses your microphone for real-time two-way audio during live telehealth consultations and encrypted audio voice notes with your lead coach.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Gordon Athletic Advisory accesses your photo library to allow you to upload physique progression photos and gym movement critique videos.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Gordon Athletic Advisory saves your 3D postural screen reports and milestone workout summary cards to your photo library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Gordon Athletic Advisory uses your location to track outdoor running distance, split pace, and route elevation during outdoor cardio sessions.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.gordonathletic.app.healthkit.refresh</string>
	</array>
</dict>
</plist>
