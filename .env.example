# =============================================================================
# Forge Athletic — Environment Configuration Template
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase Backend (Required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# 2. App & Site URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production origin: https://forge-athletic.app
# Set these URL variables to the production origin in your deployment environment.
# ALLOWED_APP_BASE_URLS=http://localhost:3000,https://forge-athletic.app

# -----------------------------------------------------------------------------
# 2b. SEO Verification (Zero Third-Party Analytics / Zero Health Tracking Pixels)
# -----------------------------------------------------------------------------
# NOTE: Google Analytics 4 and third-party ad/behavioral tracking pixels are
# intentionally excluded across Forge Athletic to enforce strict compliance with
# the FTC Health Breach Notification Rule (16 CFR Part 318), WA MHMDA, and
# Massachusetts Wiretap Act (M.G.L. c. 272, § 99).

# Google Search Console Site Verification Meta Token (Optional)
# Obtain free from search.google.com/search-console -> Settings -> Ownership Verification -> HTML tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code

# -----------------------------------------------------------------------------
# 3. Google Gemini AI (Paid API / Vertex AI Enterprise Zero-Data-Retention Required)
# -----------------------------------------------------------------------------
# IMPORTANT LEGAL REQUIREMENT: Production deployments MUST use a Paid Billing Tier
# Gemini API key or Google Cloud Vertex AI with Zero Data Retention (never Free Tier)
# so prompts/telemetry are never logged or reviewed for public model training.
GEMINI_API_KEY=AIzaSy...
# GOOGLE_GENAI_API_KEY=AIzaSy... # Optional alias
# GEMINI_MODEL=gemini-2.5-flash    # Defaults to gemini-2.5-flash with 1.5 fallbacks

# -----------------------------------------------------------------------------
# 4. OpenAI (Optional — Legacy Plan Generation & Fallback TTS)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# 5. ElevenLabs Audio & Voice Synthesis (Optional — Premier Coach Voice)
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=UPezm4CtrvcD6aNXjeU1 # Default: Adam / Marcus Baritone
COACH_GORDON_ELEVENLABS_VOICE_ID=UPezm4CtrvcD6aNXjeU1 # Coach Gordon custom cloned voice ID (e.g. from ElevenLabs VoiceLab)

# -----------------------------------------------------------------------------
# 6. Stripe Payments & Billing Portal
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Enable automated SaaS / digital coaching sales tax calculation once Stripe Tax
# nexus registrations (e.g., MA 830 CMR 64H.1.7, NY, TX, PA, WA) are configured in Stripe Dashboard:
STRIPE_AUTOMATIC_TAX_ENABLED=false

# -----------------------------------------------------------------------------
# 7. Resend & Marketing Email Automation
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_...
MARKETING_FROM_EMAIL=coaching@yourdomain.com
MARKETING_INTERNAL_NOTIFY_EMAIL=coach@yourdomain.com
MARKETING_REPLY_TO_EMAIL=coach@yourdomain.com
MARKETING_BASE_URL=http://localhost:3000
MARKETING_SEQUENCE_ENABLED=1
# Optional: force emails generated during local dev to use production URLs (prevents Resend domain mismatch warnings)
# EMAIL_LINK_BASE_URL=https://forge-athletic.app
# RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret # Optional in dev; verifies svix signatures from Resend webhooks

# -----------------------------------------------------------------------------
# 7b. SMS notifications (Twilio). Optional: texts are skipped when unset.
# Point the Twilio number's inbound webhook at POST /api/webhooks/twilio (handles STOP/START/HELP).
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+16175550100
# TWILIO_MESSAGING_SERVICE_SID=MG... # Optional: use instead of TWILIO_FROM_NUMBER

# -----------------------------------------------------------------------------
# 8. Scheduled Cron Job Secrets
# -----------------------------------------------------------------------------
# Header: x-marketing-cron-secret on POST /api/marketing/dispatch
MARKETING_CRON_SECRET=your-marketing-cron-secret
# Header: Authorization: Bearer <secret> on POST /api/internal/notifications/weekly-checkin
INTERNAL_CRON_SECRET=your-internal-cron-secret

# -----------------------------------------------------------------------------
# 9. Apple APNs Push Notifications (iOS Native & PWA)
# -----------------------------------------------------------------------------
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_PUSH_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_BUNDLE_ID=app.forgeathletic.client
APPLE_PUSH_USE_SANDBOX=true

# -----------------------------------------------------------------------------
# 10. Wearables & Telemetry Integrations
# -----------------------------------------------------------------------------
# Webhook signature verification for inbound telemetry
APPLE_HEALTH_WEBHOOK_SECRET=your-apple-health-secret
GOOGLE_HEALTH_WEBHOOK_SECRET=your-google-health-secret

# Vital Health API (Optional multi-wearable bridge: Oura, Whoop, Garmin)
VITAL_API_KEY=sk_...
VITAL_ENVIRONMENT=sandbox # sandbox | production
# VITAL_WEBHOOK_SECRET=your-vital-webhook-secret

# -----------------------------------------------------------------------------
# 11. Leonardo AI (Optional — Physique Projection / Predict Look)
# -----------------------------------------------------------------------------
LEONARDO_API_KEY=...
# LEONARDO_SEED=42

# -----------------------------------------------------------------------------
# 12. Public Dispensaries, App Stores & Feature Switches
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DISPENSARY_ENABLED=true
NEXT_PUBLIC_THORNE_DISPENSARY_URL=https://www.thorne.com/u/forgeathletic
NEXT_PUBLIC_THORNE_AFFILIATE_ID=PR2650699
NEXT_PUBLIC_EQUIPMENT_DISPENSARY_ENABLED=true
# Optional: set once approved for REP Fitness Web Affiliate (https://repfitness.postaffiliatepro.com/affiliates/signup.php#SignupForm — no Instagram/Facebook required),
# Crossover Symmetry Coach Pro (15% off), and Perform Better / Power Systems Pro (10% off)
# NEXT_PUBLIC_REP_FITNESS_URL=https://repfitness.com
# NEXT_PUBLIC_REP_FITNESS_AFFILIATE_ID=your-rep-affiliate-id
# NEXT_PUBLIC_REP_FITNESS_AFFILIATE_PARAM=a_aid
# NEXT_PUBLIC_REP_FITNESS_CODE=
# NEXT_PUBLIC_REP_FITNESS_DISCOUNT_PCT=0
# NEXT_PUBLIC_CROSSOVER_SYMMETRY_URL=https://crossoversymmetry.com
# NEXT_PUBLIC_CROSSOVER_SYMMETRY_CODE=FORGE15
# NEXT_PUBLIC_PERFORM_BETTER_URL=https://www.performbetter.com
# NEXT_PUBLIC_PERFORM_BETTER_AFFILIATE_ID=your-pb-or-cj-affiliate-id
# NEXT_PUBLIC_PERFORM_BETTER_CODE=FORGE10
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/forge-athletic/id000000000
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=app.forgeathletic.client
NEXT_PUBLIC_PRELAUNCH_WAITLIST_MODE=0 # 1: waitlist capture, 0: live applications
NEXT_PUBLIC_ALLOW_ANON_PREVIEW=false  # Set to true only for local dev demos without auth
ENABLE_DEMO_LOGIN=true                # Set to true to enable /api/auth/demo VIP demo athlete login
