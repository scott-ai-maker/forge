<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Forge</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.gordonathletic.app.watchkitapp</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Forge Athletic</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.gordonathletic.app</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Forge Athletic streams optical heart rate and HRV telemetry from Apple Watch to autoregulate in-gym rest intervals, monitor Tanaka cardio stages, and assess CNS recovery readiness.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Forge Athletic records completed strength training and cardio sessions directly into Apple Health with true active calories and heart rate samples.</string>
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
