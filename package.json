{
  "name": "forge-athletic",
  "version": "1.36.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "sync:sw": "node scripts/sync-sw-version.mjs",
    "prebuild": "npm run sync:sw",
    "build": "npm run sync:sw && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "npm run typecheck && npm run lint && npm run test",
    "test:env": "node scripts/check-dev-test-env.mjs",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test:e2e": "playwright test",
    "user:test": "node --env-file=.env.local scripts/setup-dev-test-user.mjs",
    "client:new": "node --env-file=.env.local scripts/create-test-client.mjs",
    "client:test": "node --env-file=.env.local scripts/create-test-client.mjs",
    "exercises:seed": "node --env-file=.env.local scripts/seed-exercise-library.mjs",
    "exercises:enrich-youtube": "node --env-file=.env.local scripts/enrich-youtube-videos-headless.mjs",
    "exercises:enrich-ai": "node --env-file=.env.local scripts/enrich-exercises-openai.mjs",
    "exercises:backfill-muscles": "node --env-file=.env.local scripts/backfill-muscle-groups.mjs",
    "workouts:backfill-day-tags": "node --env-file=.env.local scripts/backfill-workout-day-tags.mjs",
    "workouts:backfill-day-tags:apply": "node --env-file=.env.local scripts/backfill-workout-day-tags.mjs --apply",
    "workouts:report-day-tags": "node --env-file=.env.local scripts/report-workout-day-tags.mjs",
    "workouts:report-day-tags:json": "node --env-file=.env.local scripts/report-workout-day-tags.mjs --json",
    "workouts:report-day-tags:untagged": "node --env-file=.env.local scripts/report-workout-day-tags.mjs --only-untagged",
    "workouts:remap-official-exercises": "node --env-file=.env.local scripts/remap-client-exercises-to-official.mjs",
    "workouts:remap-official-exercises:apply": "node --env-file=.env.local scripts/remap-client-exercises-to-official.mjs --apply",
    "workouts:report-day-tags:untagged:json": "node --env-file=.env.local scripts/report-workout-day-tags.mjs --only-untagged --json",
    "templates:seed:nasm": "node --env-file=.env.local scripts/seed-nasm-opt-templates.mjs",
    "smoke:auth": "node --env-file=.env.local scripts/authenticated-smoke-harness.mjs",
    "emails:dispatch": "node --env-file=.env.local scripts/dispatch-marketing-emails.mjs",
    "emails:verify": "node --env-file=.env.local scripts/verify-email-health.mjs",
    "generate-images": "node scripts/generate-images.mjs",
    "cap:sync": "npm run sync:sw && cap sync",
    "cap:open": "cap open ios",
    "cap:build:ios": "npm run sync:sw && cap sync ios",
    "ios:dev": "cap open ios",
    "ios:archive": "npm run sync:sw && npx cap sync ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -destination 'generic/platform=iOS' -archivePath ios/App/build/App.xcarchive archive",
    "ios:export": "xcodebuild -exportArchive -archivePath ios/App/build/App.xcarchive -exportPath ios/App/build/export -exportOptionsPlist ios/App/exportOptions.plist -allowProvisioningUpdates",
    "cap:sync:android": "cap sync android",
    "cap:open:android": "cap open android",
    "android:dev": "cap open android",
    "android:test": "cd android && ./gradlew testDebugUnitTest",
    "cap:build:android": "cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.1",
    "@livekit/track-processors": "^0.7.2",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@stripe/stripe-js": "^9.16.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.102.1",
    "lucide-react": "^1.7.0",
    "next": "^16.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.11.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
